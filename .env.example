# ─────────────────────────────────────────────────────────────
#  Crypto Arbitrage Scanner Bot — environment configuration
#  Copy to `.env` and fill real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── Core ──
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                     # true -> JSON logs (prod), false -> console

# ── Telegram ──
BOT_TOKEN=123456:REPLACE_WITH_BOTFATHER_TOKEN
BOT_USERNAME=my_arb_bot
# Webhook secret token (Telegram X-Telegram-Bot-Api-Secret-Token) — NFR-SEC-02
TELEGRAM_WEBHOOK_SECRET=change-me-random-32-chars
# Comma-separated Telegram user_ids granted Administrator role — BR-ROLE-1
ADMIN_USER_IDS=
# Comma-separated Telegram user_ids granted Support role
SUPPORT_USER_IDS=

# ── Database ──
DATABASE_URL=postgresql+asyncpg://arb:arb@localhost:5432/arb
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── Redis (cooldown / rate-limit / optional shared cache) ──
REDIS_URL=redis://localhost:6379/0

# ── Payments ──
TELEGRAM_PAYMENTS_PROVIDER_TOKEN=
PAYMENT_WEBHOOK_SECRET=change-me-payment-secret
PRICE_BASIC_USD=19
PRICE_PRO_USD=79

# ── Scanner: exchange / RPC endpoints ──
# CEX use public market-data endpoints only (NFR-SEC-01: no user API keys).
# Binance public market data uses the Binance Vision domains (api.binance.com /
# stream.binance.com return HTTP 451 from restricted locations).
BINANCE_REST_URL=https://data-api.binance.vision
BINANCE_WS_URL=wss://data-stream.binance.vision/stream
# Binance-only proxy chain (empty = direct). http://, https://, socks4://, socks5:// —
# used when the server IP gets HTTP 451 on every Binance host. Binance REST + WS only.
# The fallback is switched to automatically when the primary proxy fails.
BINANCE_PROXY=
BINANCE_PROXY_FALLBACK=
OKX_REST_URL=https://www.okx.com
OKX_WS_URL=wss://ws.okx.com:8443/ws/v5/public
BITGET_REST_URL=https://api.bitget.com
BITGET_WS_URL=wss://ws.bitget.com/v2/ws/public
MEXC_REST_URL=https://api.mexc.com
MEXC_WS_URL=wss://wbs.mexc.com/ws

# DEX: RPC providers (>=2 per network for failover, §2.4). A curated set of independent
# keyless public fallbacks is appended automatically (settings.py _EXTRA_FALLBACK_RPCS):
# 15 for ETH and 9 for BNB as of 2026-07-11, each verified live without an API key. So one
# entry per network here is enough — you do NOT need to paste the public list below.
#
# PRIORITY & RELIABILITY: URLs are tried in the order listed here FIRST, then the built-in
# public fallbacks. Free public nodes are slow/rate-limited (prod logs showed 2–7s latency,
# constant timeout churn, and whole-network `rpc_all_providers_failed` outages on ETH/BNB).
# For production, put >=2 PAID providers (Alchemy / QuickNode / Ankr-with-key / dRPC-paid)
# FIRST on ETHEREUM_RPC_URLS and BNB_RPC_URLS — they are the two heaviest DEX networks and
# the ones that went fully dark on public nodes. The pool ranks by live latency, so faster
# paid endpoints win automatically and the public entries only serve as last-resort backup.
# NOTE: public unauthenticated Ankr endpoints (rpc.ankr.com/<chain>) now require a key
# and are dropped automatically. Set ANKR_API_KEY to use the authenticated endpoints.
ETHEREUM_RPC_URLS=https://ethereum-rpc.publicnode.com,https://eth.drpc.org
BNB_RPC_URLS=https://bsc-rpc.publicnode.com,https://bsc-dataseed.binance.org
ARBITRUM_RPC_URLS=https://arbitrum-one-rpc.publicnode.com,https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URLS=https://optimism-rpc.publicnode.com,https://mainnet.optimism.io
BASE_RPC_URLS=https://base-rpc.publicnode.com,https://mainnet.base.org
POLYGON_RPC_URLS=https://polygon-bor-rpc.publicnode.com,https://polygon-rpc.com
SOLANA_RPC_URLS=https://api.mainnet-beta.solana.com,https://solana-rpc.publicnode.com
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1

# ── Paid / authenticated RPC providers (PRIMARY tier — recommended for production) ──
# When set, these are placed first in the pool and marked as the primary tier: the
# health-scored rotation prefers them and only drops to the keyless public nodes above
# when every primary is unhealthy. This is the direct fix for the observed whole-network
# `rpc_all_providers_failed` storms on ETH/BNB (all public nodes rate-limited at once).
# ALCHEMY_API_KEY builds https://<net>.g.alchemy.com/v2/<key> for eth/bnb/arb/opt/base/polygon.
ALCHEMY_API_KEY=
# QuickNode issues a full, token-bearing URL per network — paste the whole endpoint URL.
QUICKNODE_ETHEREUM_URL=
QUICKNODE_BNB_URL=
# Optional: enables authenticated Ankr endpoints (added to the primary tier). Empty = skip Ankr.
ANKR_API_KEY=

# ── Scanner tuning (all hot-reloadable, §20) — overrides bundled defaults ──
SCANNER_CONFIG_FILE=config/scanner.toml
